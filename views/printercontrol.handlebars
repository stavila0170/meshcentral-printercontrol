<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title>Print jobs</title>
    <style>
        :root { color-scheme:light dark; --border:#b8b8b8; --panel:#f5f6f7; --danger:#b42318; --ok:#067647; --accent:#1769aa; }
        * { box-sizing:border-box; }
        html { width:100%; height:100%; overflow:auto; }
        body { width:100%; min-width:0; min-height:100%; margin:0; padding:12px 12px 72px; overflow:auto; font:13px "Segoe UI",Arial,sans-serif; color:#222; background:#fff; }
        .panel { border:1px solid var(--border); border-radius:6px; overflow:hidden; }
        .panel-head { display:flex; align-items:center; gap:8px; flex-wrap:wrap; padding:10px; background:var(--panel); border-bottom:1px solid var(--border); }
        .panel-head h2 { margin:0; font-size:16px; }
        .spacer { flex:1; }
        .badge { display:inline-block; padding:3px 8px; border:1px solid #98a2b3; border-radius:999px; font-weight:600; color:#344054; background:#eaecf0; }
        .badge.ok { color:var(--ok); background:#d1fadf; }
        .badge.bad { color:var(--danger); background:#fee4e2; }
        .badge.unknown { color:#344054; background:#eaecf0; }
        .message { min-height:34px; margin:9px 0; padding:8px 10px; border-radius:4px; background:#eef4ff; }
        .message:empty { display:none; }
        .message.error { color:var(--danger); background:#fee4e2; }
        .message.success { color:var(--ok); background:#d1fadf; }
        .table-wrap { width:100%; max-width:100%; max-height:620px; overflow:auto; }
        table { width:100%; min-width:1050px; border-collapse:collapse; }
        th,td { padding:7px 8px; border-bottom:1px solid #ddd; text-align:left; vertical-align:middle; overflow-wrap:anywhere; }
        th { position:sticky; top:0; z-index:1; background:#eceff2; }
        tbody tr:hover { background:#f7faff; }
        tr.recent { opacity:.75; }
        .empty { padding:24px; color:#666; text-align:center; }
        .muted { color:#667085; }
        .status { font-weight:600; }
        .status.printing { color:#067647; }
        .status.warning { color:#b54708; }
        .status.error { color:#b42318; }
        button { padding:4px 8px; margin:1px 3px 1px 0; border:1px solid #999; border-radius:4px; background:#fff; color:#222; cursor:pointer; font-size:12px; }
        button:hover:not(:disabled) { border-color:var(--accent); }
        button:disabled { opacity:.42; cursor:not-allowed; }
        button.danger { color:var(--danger); border-color:#d92d20; }
        @media (prefers-color-scheme:dark) {
            :root { --border:#555; --panel:#292929; }
            body { color:#eee; background:#1e1e1e; }
            th { background:#303030; } td,th { border-bottom-color:#444; } tbody tr:hover { background:#26374a; }
            button { color:#eee; background:#303030; border-color:#666; }
            .message { background:#26374a; } .muted,.empty { color:#aaa; }
            .badge,.badge.unknown { color:#f2f4f7; background:#475467; border-color:#667085; }
        }
    </style>
</head>
<body onload="printerControlOnLoad()">
    <section class="panel">
        <div class="panel-head">
            <h2>Print jobs — all printers</h2>
            <span id="liveBadge" class="badge unknown">Starting real-time monitoring...</span>
            <span id="onlineBadge" class="badge unknown">Checking agent...</span>
            <span class="spacer"></span>
            <span id="jobCount" class="muted">0 active jobs</span>
            <button id="reconnectBtn" type="button" onclick="PrinterControl.reconnect()">Reconnect</button>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Printer</th><th>ID</th><th>Document</th><th>User</th><th>Status</th>
                        <th>Driver progress</th><th>Size</th><th>Submitted</th><th>Actions</th>
                    </tr>
                </thead>
                <tbody id="jobRows"><tr><td colspan="9" class="empty">Waiting for real-time print jobs from all printers...</td></tr></tbody>
            </table>
        </div>
    </section>
    <div id="message" class="message">Loading permissions...</div>

<script>
"use strict";

var PrinterControl = (function () {
    var ALL_PRINTERS = "*";
    var RECENT_JOB_MS = 12000;
    var state = {
        nodeid: new URLSearchParams(window.location.search).get("nodeid"),
        online: false,
        permissions: [],
        permissionsLoaded: false,
        topTabActive: true,
        unloading: false,
        subscriptionId: null,
        liveRequested: false,
        subscriptionActive: false,
        watcherReady: false,
        heartbeatTimer: null,
        renewTimer: null,
        pruneTimer: null,
        reconnectTimer: null,
        reconnectAttempts: 0,
        jobsByPrinter: Object.create(null),
        recentJobs: Object.create(null),
        activeClientRequestId: null,
        activeOperation: null,
        permissionTimer: null
    };

    function hasPermission(name) { return state.permissions.indexOf(name) >= 0; }

    function createId() {
        var bytes = new Uint8Array(16);
        if (window.crypto && typeof window.crypto.getRandomValues === "function") {
            window.crypto.getRandomValues(bytes);
        } else {
            for (var i = 0; i < bytes.length; i++) bytes[i] = Math.floor(Math.random() * 256);
        }
        var value = "";
        for (var j = 0; j < bytes.length; j++) value += ("0" + bytes[j].toString(16)).slice(-2);
        return value;
    }

    function setMessage(text, kind) {
        var element = document.getElementById("message");
        element.textContent = text || "";
        element.className = "message" + (kind ? " " + kind : "");
    }

    function setLiveBadge(text, kind) {
        var badge = document.getElementById("liveBadge");
        badge.textContent = text;
        badge.className = "badge " + (kind || "unknown");
    }

    function setOnlineBadge() {
        var badge = document.getElementById("onlineBadge");
        badge.textContent = state.online ? "Agent online" : "Agent offline";
        badge.className = "badge " + (state.online ? "ok" : "bad");
    }

    function normalizeText(value) { return value == null ? "" : String(value); }
    function numberValue(value) { var n = Number(value); return isFinite(n) ? n : 0; }

    function jobIdentity(printerName, job) {
        return normalizeText(printerName).toLowerCase() + "|" + numberValue(job.id) + "|" +
            normalizeText(job.documentName).toLowerCase() + "|" + normalizeText(job.userName).toLowerCase();
    }

    function statusClass(value) {
        var text = normalizeText(value).toLowerCase();
        if (/error|offline|paper|blocked|door|toner|stopped|intervention/.test(text)) return "error";
        if (/paused|waiting|warming|busy|processing|pending/.test(text)) return "warning";
        if (/printing|spooling|physical|sent to printer|finishing/.test(text)) return "printing";
        return "";
    }

    function progressText(job) {
        if (job.recentCompleted === true) return "Spooler finished";
        if (job.physicalPending === true) {
            if (job.physicalStatusReported === true && job.deviceState) return normalizeText(job.deviceState);
            return "Not reported by driver";
        }
        var total = numberValue(job.totalPages);
        var printed = numberValue(job.pagesPrinted);
        if (total > 0) return printed + " / " + total + " page(s)";
        return "Not reported";
    }

    function sizeText(value) {
        var bytes = numberValue(value);
        if (bytes <= 0) return "—";
        if (bytes < 1024) return bytes + " B";
        if (bytes < 1048576) return (bytes / 1024).toFixed(1) + " KB";
        return (bytes / 1048576).toFixed(1) + " MB";
    }

    function submittedText(value) {
        if (!value) return "—";
        var date = new Date(value);
        if (isNaN(date.getTime())) return normalizeText(value);
        return date.toLocaleTimeString([], { hour:"2-digit", minute:"2-digit", second:"2-digit" });
    }

    function appendCell(row, text, className) {
        var cell = document.createElement("td");
        cell.textContent = text == null ? "" : String(text);
        if (className) cell.className = className;
        row.appendChild(cell);
        return cell;
    }

    function actionButton(label, callback, danger, disabled) {
        var button = document.createElement("button");
        button.type = "button";
        button.textContent = label;
        if (danger) button.className = "danger";
        button.disabled = disabled === true;
        button.onclick = callback;
        return button;
    }

    function collectRows() {
        var rows = [];
        var activeKeys = Object.create(null);
        for (var key in state.jobsByPrinter) {
            if (!Object.prototype.hasOwnProperty.call(state.jobsByPrinter, key)) continue;
            var bucket = state.jobsByPrinter[key];
            if (!bucket || !Array.isArray(bucket.jobs)) continue;
            for (var i = 0; i < bucket.jobs.length; i++) {
                var identity = jobIdentity(bucket.printerName, bucket.jobs[i]);
                activeKeys[identity] = true;
                rows.push({ printerName:bucket.printerName, job:bucket.jobs[i], recent:false, seenAt:bucket.seenAt || 0 });
            }
        }
        var now = Date.now();
        for (var recentKey in state.recentJobs) {
            if (!Object.prototype.hasOwnProperty.call(state.recentJobs, recentKey)) continue;
            var recent = state.recentJobs[recentKey];
            if (!recent || recent.expiresAt <= now) { delete state.recentJobs[recentKey]; continue; }
            if (activeKeys[recentKey]) continue;
            rows.push({ printerName:recent.printerName, job:recent.job, recent:true, seenAt:recent.seenAt || 0 });
        }
        rows.sort(function (a, b) {
            if (a.recent !== b.recent) return a.recent ? 1 : -1;
            if (a.seenAt !== b.seenAt) return b.seenAt - a.seenAt;
            var printerCompare = normalizeText(a.printerName).localeCompare(normalizeText(b.printerName));
            if (printerCompare !== 0) return printerCompare;
            return numberValue(a.job.id) - numberValue(b.job.id);
        });
        return rows;
    }

    function renderJobs() {
        var body = document.getElementById("jobRows");
        body.textContent = "";
        var rows = collectRows();
        var activeCount = 0;
        var recentCount = 0;
        for (var i = 0; i < rows.length; i++) rows[i].recent ? recentCount++ : activeCount++;
        document.getElementById("jobCount").textContent = recentCount ?
            activeCount + " active, " + recentCount + " recently sent" : activeCount + " active job(s)";

        if (!rows.length) {
            var emptyRow = document.createElement("tr");
            var emptyCell = appendCell(emptyRow,
                state.liveRequested ? "Monitoring all printers — no active print jobs." : "Real-time monitoring is inactive.",
                "empty");
            emptyCell.colSpan = 9;
            body.appendChild(emptyRow);
            return;
        }

        for (var index = 0; index < rows.length; index++) {
            (function (entry) {
                var job = entry.job || {};
                var row = document.createElement("tr");
                if (entry.recent) row.className = "recent";
                appendCell(row, entry.printerName || "Unknown printer");
                appendCell(row, numberValue(job.id) || "—");
                appendCell(row, normalizeText(job.documentName) || "Unknown document");
                appendCell(row, normalizeText(job.userName) || "—");
                appendCell(row, normalizeText(job.jobStatus) || "Queued", "status " + statusClass(job.jobStatus));
                appendCell(row, progressText(job));
                appendCell(row, sizeText(job.size));
                appendCell(row, submittedText(job.submittedTime));

                var actions = document.createElement("td");
                var actionable = !entry.recent && job.physicalPending !== true && numberValue(job.id) > 0 &&
                    state.online && hasPermission("manage_jobs") && state.activeClientRequestId == null;
                actions.appendChild(actionButton("Pause", function () {
                    sendJobAction("pauseJob", entry.printerName, numberValue(job.id));
                }, false, !actionable));
                actions.appendChild(actionButton("Resume", function () {
                    sendJobAction("resumeJob", entry.printerName, numberValue(job.id));
                }, false, !actionable));
                actions.appendChild(actionButton("Cancel", function () {
                    sendJobAction("cancelJob", entry.printerName, numberValue(job.id));
                }, true, !actionable));
                row.appendChild(actions);
                body.appendChild(row);
            })(rows[index]);
        }
    }

    function recordEvent(event) {
        var printerName = normalizeText(event.printerName);
        if (!printerName) return;
        var now = Date.now();
        var active = [];
        var jobs = Array.isArray(event.jobs) ? event.jobs : [];
        if (!jobs.length && (event.jobId || event.document || event.status)) {
            jobs = [{
                id:numberValue(event.jobId), documentName:normalizeText(event.document), userName:normalizeText(event.owner),
                jobStatus:normalizeText(event.status), totalPages:0, pagesPrinted:0, size:0, submittedTime:event.timestamp || null,
                recentCompleted:/completed|sent to printer/i.test(normalizeText(event.eventType) + " " + normalizeText(event.status))
            }];
        }

        for (var i = 0; i < jobs.length; i++) {
            var job = jobs[i] || {};
            if (job.recentCompleted === true) {
                state.recentJobs[jobIdentity(printerName, job)] = {
                    printerName:printerName, job:job, seenAt:now, expiresAt:now + RECENT_JOB_MS
                };
            } else {
                active.push(job);
            }
        }
        state.jobsByPrinter[printerName.toLowerCase()] = { printerName:printerName, jobs:active, seenAt:now };
        renderJobs();
    }

    function clearTimers() {
        if (state.heartbeatTimer != null) { clearInterval(state.heartbeatTimer); state.heartbeatTimer = null; }
        if (state.renewTimer != null) { clearTimeout(state.renewTimer); state.renewTimer = null; }
        if (state.pruneTimer != null) { clearInterval(state.pruneTimer); state.pruneTimer = null; }
    }

    function clearReconnectTimer() {
        if (state.reconnectTimer != null) { clearTimeout(state.reconnectTimer); state.reconnectTimer = null; }
    }

    function sendSubscription(subscribe) {
        if (!state.nodeid || !state.subscriptionId || (state.unloading && subscribe)) return false;
        parent.meshserver.send({
            action:"plugin", plugin:"printercontrol",
            pluginaction:subscribe ? "subscribeJobs" : "unsubscribeJobs",
            nodeid:state.nodeid,
            params:{ subscriptionId:state.subscriptionId, printerName:ALL_PRINTERS }
        });
        return true;
    }

    function heartbeat() {
        if (!state.topTabActive || !state.liveRequested || !state.subscriptionActive || !state.subscriptionId) return false;
        parent.meshserver.send({
            action:"plugin", plugin:"printercontrol", pluginaction:"heartbeatJobs",
            nodeid:state.nodeid, params:{ subscriptionId:state.subscriptionId }
        });
        return true;
    }

    function startTimers() {
        clearTimers();
        heartbeat();
        state.heartbeatTimer = setInterval(heartbeat, 15000);
        state.pruneTimer = setInterval(renderJobs, 1000);
        state.renewTimer = setTimeout(function () {
            if (!state.liveRequested || state.unloading || !state.topTabActive) return;
            stopLiveEvents(null, true);
            scheduleReconnect(null, 250);
        }, 570000);
    }

    function clearLiveState() {
        clearTimers();
        state.liveRequested = false;
        state.subscriptionActive = false;
        state.watcherReady = false;
        setLiveBadge(state.topTabActive ? "Real-time monitoring off" : "Real-time monitoring inactive", "unknown");
        renderJobs();
    }

    function scheduleReconnect(reason, forcedDelay) {
        if (state.unloading || !state.topTabActive || !state.online || !hasPermission("can_view")) return false;
        clearReconnectTimer();
        var delays = [1000, 3000, 10000, 30000];
        var delay = typeof forcedDelay === "number" ? forcedDelay : delays[Math.min(state.reconnectAttempts, delays.length - 1)];
        state.reconnectAttempts++;
        state.subscriptionId = createId();
        setLiveBadge("Reconnecting real-time monitoring...", "unknown");
        if (reason) setMessage(reason + " Reconnecting automatically...", "error");
        state.reconnectTimer = setTimeout(function () {
            state.reconnectTimer = null;
            startLiveEvents();
        }, delay);
        return true;
    }

    function startLiveEvents() {
        if (!state.topTabActive || state.unloading || !state.online || !hasPermission("can_view") || state.liveRequested) return false;
        clearReconnectTimer();
        state.liveRequested = true;
        state.subscriptionActive = false;
        state.watcherReady = false;
        setLiveBadge("Starting real-time monitoring...", "unknown");
        if (!sendSubscription(true)) { clearLiveState(); return false; }
        renderJobs();
        return true;
    }

    function stopLiveEvents(reason, silent) {
        var shouldUnsubscribe = state.liveRequested || state.subscriptionActive;
        state.liveRequested = false;
        clearTimers();
        if (shouldUnsubscribe && state.subscriptionId) {
            sendSubscription(false);
            state.subscriptionId = createId();
        }
        state.subscriptionActive = false;
        state.watcherReady = false;
        setLiveBadge(state.topTabActive ? "Real-time monitoring off" : "Real-time monitoring inactive", "unknown");
        renderJobs();
        if (reason && silent !== true && !state.unloading) setMessage(reason, "error");
        return shouldUnsubscribe;
    }

    function activateLiveTab() {
        state.unloading = false;
        state.topTabActive = true;
        state.reconnectAttempts = 0;
        if (state.permissionsLoaded) startLiveEvents();
        return true;
    }

    function deactivateLiveTab() {
        state.topTabActive = false;
        clearReconnectTimer();
        stopLiveEvents(null, true);
        return true;
    }

    function unsubscribeJobs() {
        state.unloading = true;
        state.topTabActive = false;
        clearReconnectTimer();
        return stopLiveEvents(null, true);
    }

    function requestPermissions() {
        if (!state.nodeid) { setMessage("Missing node identifier.", "error"); return false; }
        if (state.permissionTimer != null) clearTimeout(state.permissionTimer);
        state.permissionTimer = setTimeout(function () {
            state.permissionTimer = null;
            if (!state.permissionsLoaded) setMessage("Permission and agent-status request timed out.", "error");
        }, 30000);
        parent.meshserver.send({ action:"plugin", plugin:"printercontrol", pluginaction:"getPermissions", nodeid:state.nodeid });
        return true;
    }

    function sendJobAction(operation, printerName, jobId) {
        if (!state.nodeid || !state.online || !hasPermission("manage_jobs")) return false;
        if (state.activeClientRequestId != null) { setMessage("Another print-job operation is already running."); return false; }
        if (!printerName || !jobId) return false;
        var requestId = createId();
        state.activeClientRequestId = requestId;
        state.activeOperation = operation;
        setMessage("Running " + operation + "...");
        renderJobs();
        parent.meshserver.send({
            action:"plugin", plugin:"printercontrol", pluginaction:operation, nodeid:state.nodeid,
            clientRequestId:requestId, params:{ printerName:printerName, jobId:jobId }
        });
        return true;
    }

    function reconnect() {
        if (!state.permissionsLoaded) return requestPermissions();
        clearReconnectTimer();
        if (state.liveRequested || state.subscriptionActive) stopLiveEvents(null, true);
        state.reconnectAttempts = 0;
        if (state.online && hasPermission("can_view") && state.topTabActive) {
            setTimeout(startLiveEvents, 100);
        } else {
            requestPermissions();
        }
        return true;
    }

    function handleMessage(message) {
        if (!message || (message.nodeid && state.nodeid && message.nodeid !== state.nodeid)) return;

        if (message.type === "permissions") {
            if (state.permissionTimer != null) { clearTimeout(state.permissionTimer); state.permissionTimer = null; }
            state.permissionsLoaded = true;
            state.online = message.online === true;
            state.permissions = Array.isArray(message.permissions) ? message.permissions : [];
            setOnlineBadge();
            if (!hasPermission("can_view")) {
                clearLiveState();
                setMessage("Access denied. Grant the 'View printers' plugin permission.", "error");
            } else if (!state.online) {
                clearLiveState();
                setMessage("MeshAgent is offline.", "error");
            } else {
                setMessage("");
                startLiveEvents();
            }
            renderJobs();
            return;
        }

        if (message.type === "subscription") {
            if (message.subscriptionId !== state.subscriptionId) return;
            state.subscriptionActive = message.success === true && message.active === true && state.liveRequested;
            if (state.subscriptionActive) {
                setLiveBadge(state.watcherReady ? "Real-time monitoring on" : "Starting endpoint watcher...", state.watcherReady ? "ok" : "unknown");
                startTimers();
            }
            return;
        }

        if (message.type === "watcherStatus") {
            if (message.success === true && state.liveRequested && state.subscriptionActive) {
                state.watcherReady = true;
                state.reconnectAttempts = 0;
                setLiveBadge("Real-time monitoring on", "ok");
                setMessage("");
            } else if (message.success !== true) {
                var watcherError = message.error || "Real-time print-job monitoring is unavailable.";
                clearLiveState();
                setLiveBadge("Real-time monitoring unavailable", "bad");
                scheduleReconnect(watcherError);
            }
            return;
        }

        if (message.type === "heartbeat") {
            if (message.subscriptionId !== state.subscriptionId) return;
            if (message.success !== true) {
                var heartbeatError = message.error || "Real-time monitoring subscription expired.";
                clearLiveState();
                scheduleReconnect(heartbeatError);
            }
            return;
        }

        if (message.type === "subscriptionExpired") {
            if (message.subscriptionId !== state.subscriptionId) return;
            var expiryReason = message.reason || "Real-time monitoring expired.";
            clearLiveState();
            scheduleReconnect(expiryReason);
            return;
        }

        if (message.type === "jobEvent") {
            if (message.subscriptionId !== state.subscriptionId || !message.event) return;
            recordEvent(message.event);
            return;
        }

        if (message.type === "queued" || message.type === "started") {
            if (message.clientRequestId && message.clientRequestId !== state.activeClientRequestId) return;
            setMessage(message.type === "queued" ? "Print-job operation queued..." : "Print-job operation running...");
            return;
        }

        if (message.type !== "result") return;
        if (message.clientRequestId && state.activeClientRequestId && message.clientRequestId !== state.activeClientRequestId) return;
        var isActiveResult = state.activeClientRequestId != null &&
            ((message.clientRequestId && message.clientRequestId === state.activeClientRequestId) ||
             (!message.clientRequestId && message.operation === state.activeOperation));
        if (isActiveResult) {
            state.activeClientRequestId = null;
            state.activeOperation = null;
            renderJobs();
        }
        if (message.operation === "subscribeJobs" || message.operation === "heartbeatJobs") {
            if (!message.success) {
                var liveError = message.error || "Unable to start real-time monitoring.";
                clearLiveState();
                scheduleReconnect(liveError);
            }
            return;
        }
        if (message.operation === "unsubscribeJobs") return;
        if (!message.success) {
            setMessage(message.error || "Print-job operation failed.", "error");
            return;
        }
        if (message.operation === "cancelJob" || message.operation === "pauseJob" || message.operation === "resumeJob") {
            setMessage("Print-job operation completed.", "success");
        }
    }

    function initialize() {
        state.subscriptionId = createId();
        state.unloading = false;
        state.topTabActive = true;
        renderJobs();
        return requestPermissions();
    }

    return {
        initialize:initialize,
        handleMessage:handleMessage,
        activateLiveTab:activateLiveTab,
        deactivateLiveTab:deactivateLiveTab,
        startLiveEvents:startLiveEvents,
        stopLiveEvents:stopLiveEvents,
        unsubscribeJobs:unsubscribeJobs,
        reconnect:reconnect
    };
})();

function printerControlOnLoad() {
    if (!parent.pluginHandler.printercontrol) parent.pluginHandler.printercontrol = {};
    parent.pluginHandler.printercontrol.handlePrinterMessage = function (x, message) {
        PrinterControl.handleMessage(message);
    };
    PrinterControl.initialize();
    window.addEventListener("pagehide", PrinterControl.unsubscribeJobs);
    window.addEventListener("beforeunload", PrinterControl.unsubscribeJobs);
}
</script>
</body>
</html>
