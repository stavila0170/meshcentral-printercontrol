<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title>Printer Control</title>
    <style>
        :root { color-scheme: light dark; --border:#b8b8b8; --panel:#f5f6f7; --danger:#b42318; --ok:#067647; --accent:#1769aa; }
        * { box-sizing:border-box; }
        html { width:100%; height:100%; overflow:auto; }
        body { width:100%; min-width:0; min-height:100%; margin:0; padding:12px 12px 72px; overflow:auto; font:13px "Segoe UI",Arial,sans-serif; color:#222; background:#fff; }
        .toolbar,.panel-head,.actions { display:flex; align-items:center; gap:7px; flex-wrap:wrap; }
        .toolbar { padding:10px; border:1px solid var(--border); background:var(--panel); border-radius:6px; }
        .toolbar .spacer { flex:1; }
        button { padding:6px 10px; border:1px solid #999; border-radius:4px; background:#fff; color:#222; cursor:pointer; }
        button:hover:not(:disabled) { border-color:var(--accent); }
        button:disabled { opacity:.45; cursor:not-allowed; }
        button.danger { color:var(--danger); border-color:#d92d20; }
        button.small { padding:3px 7px; font-size:12px; }
        .badge { display:inline-block; padding:3px 8px; border:1px solid #98a2b3; border-radius:999px; font-weight:600; color:#344054; background:#eaecf0; }
        .badge.ok { color:var(--ok); background:#d1fadf; }
        .badge.bad { color:var(--danger); background:#fee4e2; }
        .badge.unknown { color:#344054; background:#eaecf0; border:1px solid #98a2b3; }
        .message { min-height:34px; margin:9px 0; padding:8px 10px; border-radius:4px; background:#eef4ff; }
        .message:empty { display:none; }
        .message.error { color:var(--danger); background:#fee4e2; }
        .message.success { color:var(--ok); background:#d1fadf; }
        .panel { margin-top:10px; border:1px solid var(--border); border-radius:6px; overflow:hidden; }
        .panel-head { padding:9px 10px; background:var(--panel); border-bottom:1px solid var(--border); }
        .panel-head h2 { margin:0; font-size:15px; }
        .panel-head .spacer { flex:1; }
        .table-wrap { width:100%; max-width:100%; max-height:420px; overflow:auto; }
        table { width:100%; min-width:860px; border-collapse:collapse; }
        th,td { padding:7px 8px; border-bottom:1px solid #ddd; text-align:left; vertical-align:middle; overflow-wrap:anywhere; }
        th { position:sticky; top:0; z-index:1; background:#eceff2; }
        tbody tr:hover { background:#f7faff; }
        .empty { padding:20px; color:#666; text-align:center; }
        .empty.error-text { color:var(--danger); }
        details { margin-top:10px; border:1px solid var(--border); border-radius:6px; padding:8px 10px; }
        summary { cursor:pointer; font-weight:600; }
        .form-grid { display:grid; grid-template-columns:repeat(4,minmax(140px,1fr)); gap:8px; margin-top:10px; }
        label { display:flex; flex-direction:column; gap:4px; }
        input,select { width:100%; padding:6px; border:1px solid #999; border-radius:4px; background:#fff; color:#222; }
        .form-actions { margin-top:9px; }
        .muted { color:#666; }
        @media (prefers-color-scheme:dark) {
            :root { --border:#555; --panel:#292929; }
            body { color:#eee; background:#1e1e1e; }
            button,input,select { color:#eee; background:#303030; border-color:#666; }
            th { background:#303030; } td,th { border-bottom-color:#444; } tbody tr:hover { background:#26374a; }
            .message { background:#26374a; } .muted { color:#aaa; }
            .badge { color:#f2f4f7; background:#475467; border-color:#667085; }
            .badge.unknown { color:#f2f4f7; background:#475467; border-color:#667085; }
        }
    </style>
</head>
<body onload="printerControlOnLoad()">
    <div class="toolbar">
        <strong>Print Spooler:</strong>
        <span id="spoolerBadge" class="badge unknown">Unknown</span>
        <button id="refreshBtn" onclick="PrinterControl.manualRefresh()">Refresh</button>
        <button data-permission="manage_spooler" onclick="PrinterControl.run('spoolerStart',{})">Start</button>
        <button data-permission="manage_spooler" onclick="PrinterControl.run('spoolerStop',{})">Stop</button>
        <button data-permission="manage_spooler" onclick="PrinterControl.run('spoolerRestart',{})">Restart</button>
        <button class="danger" data-permission="manage_spooler" onclick="PrinterControl.clearQueue()">Clear queue</button>
        <span class="spacer"></span>
        <span id="onlineBadge" class="badge unknown">Checking agent...</span>
    </div>

    <div id="message" class="message">Loading permissions...</div>

    <details id="addPanel">
        <summary>Add TCP/IP printer</summary>
        <div class="form-grid">
            <label>Printer name<input id="addName" maxlength="220" autocomplete="off"></label>
            <label>IP address / DNS<input id="addAddress" maxlength="255" autocomplete="off"></label>
            <label>Installed driver<input id="addDriver" maxlength="220" list="driverList" autocomplete="off"></label>
            <label>Port name (optional)<input id="addPort" maxlength="220" placeholder="IP_192.0.2.10" autocomplete="off"></label>
        </div>
        <datalist id="driverList"></datalist>
        <div class="form-actions">
            <button data-permission="manage_printers" onclick="PrinterControl.addTcpPrinter()">Add printer</button>
            <span class="muted">The driver must already exist on the endpoint.</span>
        </div>
    </details>

    <section class="panel">
        <div class="panel-head"><h2>Printers</h2><span class="spacer"></span><span id="printerCount" class="muted"></span></div>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Name</th><th>Status</th><th>Driver</th><th>Port</th><th>Jobs</th><th>Shared</th><th>Actions</th></tr></thead>
                <tbody id="printerRows"><tr><td colspan="7" class="empty">No data loaded.</td></tr></tbody>
            </table>
        </div>
    </section>

    <section class="panel">
        <div class="panel-head"><h2 id="jobsTitle">Print jobs</h2><span id="jobsLiveBadge" class="badge unknown">Live events off</span><span class="spacer"></span><button id="jobsLiveToggle" class="small" disabled onclick="PrinterControl.toggleLiveEvents()">Start live events</button><button id="jobsRefresh" class="small" disabled onclick="PrinterControl.reloadJobs()">Refresh jobs</button></div>
        <div class="table-wrap">
            <table>
                <thead><tr><th>ID</th><th>Document</th><th>User</th><th>Status</th><th>Driver progress</th><th>Size</th><th>Actions</th></tr></thead>
                <tbody id="jobRows"><tr><td colspan="7" class="empty">Select a printer to view its queue.</td></tr></tbody>
            </table>
        </div>
    </section>

    <section id="activityPanel" class="panel" hidden>
        <div class="panel-head"><h2>Active print jobs — all printers</h2><span id="activityBadge" class="badge unknown">Stopped</span><span class="spacer"></span><span id="activityCount" class="muted"></span></div>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Printer</th><th>ID</th><th>Document</th><th>User</th><th>Status</th><th>Driver progress</th><th>Size</th></tr></thead>
                <tbody id="activityRows"><tr><td colspan="7" class="empty">Start live events to monitor all printer queues.</td></tr></tbody>
            </table>
        </div>
    </section>

<script>
"use strict";

var PrinterControl = (function () {
    var DEFAULT_OPERATION_TIMEOUT_MS = 135000;
    var OPERATION_TIMEOUTS_MS = {
        inventory: 105000,
        jobs: 60000,
        cancelJob: 45000,
        pauseJob: 45000,
        resumeJob: 45000,
        testPage: 45000,
        addTcpPrinter: 105000,
        deletePrinter: 105000,
        removePort: 105000,
        removeDriver: 105000,
        spoolerStart: 60000,
        spoolerStop: 60000,
        spoolerRestart: 75000,
        clearQueue: 105000
    };
    var TEST_PAGE_JOB_RETRY_DELAYS_MS = [750, 1750];
    var localSharedInventory = { data: null, pending: false, pendingAt: 0, updatedAt: 0 };
    var state = {
        nodeid: new URLSearchParams(window.location.search).get("nodeid"),
        online: false,
        permissions: [],
        inventory: null,
        selectedPrinter: null,
        preserveSpoolerBadgeOnInventoryFailure: false,
        inventoryRequestInFlight: false,
        jobsRequestInFlight: false,
        jobsRequestSilent: false,
        activeClientRequestId: null,
        activeOperation: null,
        operationTimer: null,
        operationDeadline: 0,
        operationTimerPrefix: "",
        operationTimerJobsPlaceholder: false,
        permissionsLoaded: false,
        permissionsRequestInFlight: false,
        permissionsTimer: null,
        manualRefreshPending: false,
        subscriptionId: null,
        subscriptionPrinter: null,
        subscriptionActive: false,
        watcherReady: false,
        liveRequested: false,
        liveSwitchInFlight: false,
        pendingTestPrinter: null,
        heartbeatTimer: null,
        liveMaxTimer: null,
        eventRefreshTimer: null,
        pendingJobEvent: null,
        testPageJobPrinter: null,
        testPageJobRetryIndex: 0,
        testPageJobRetryTimer: null,
        testPageEventPrinter: null,
        liveJobsByPrinter: {},
        unloading: false
    };

    function hasPermission(name) { return state.permissions.indexOf(name) >= 0; }

    function sharedInventory() {
        try {
            if (!parent.__printerControlSharedInventory) parent.__printerControlSharedInventory = {};
            var key = String(state.nodeid || "");
            if (!parent.__printerControlSharedInventory[key]) {
                parent.__printerControlSharedInventory[key] = { data: null, pending: false, pendingAt: 0, updatedAt: 0 };
            }
            return parent.__printerControlSharedInventory[key];
        } catch (ignore) {
            return localSharedInventory;
        }
    }

    function sharedInventoryIsPending(shared) {
        if (!shared || shared.pending !== true) return false;
        if ((Date.now() - Number(shared.pendingAt || 0)) <= 150000) return true;
        shared.pending = false;
        shared.pendingAt = 0;
        return false;
    }


    function createSubscriptionId() {
        var bytes = new Uint8Array(16);
        if (window.crypto && typeof window.crypto.getRandomValues === "function") {
            window.crypto.getRandomValues(bytes);
        } else {
            for (var i = 0; i < bytes.length; i++) bytes[i] = Math.floor(Math.random() * 256);
        }
        var value = "";
        for (var j = 0; j < bytes.length; j++) value += ("0" + bytes[j].toString(16)).slice(-2);
        return value;
    }

    function setLiveBadge(text, kind) {
        var badge = document.getElementById("jobsLiveBadge");
        if (!badge) return;
        badge.textContent = text;
        badge.className = "badge " + (kind || "unknown");
    }

    function sendSubscription(subscribe, printerName) {
        if (!state.nodeid || !state.subscriptionId || (state.unloading && subscribe)) return false;
        parent.meshserver.send({
            action: "plugin",
            plugin: "printercontrol",
            pluginaction: subscribe ? "subscribeJobs" : "unsubscribeJobs",
            nodeid: state.nodeid,
            params: {
                subscriptionId: state.subscriptionId,
                printerName: printerName || state.subscriptionPrinter || state.selectedPrinter || ""
            }
        });
        return true;
    }

    function isPluginVisible() {
        try {
            if (document.hidden || (parent.document && parent.document.hidden)) return false;
            var element = window.frameElement;
            if (!element) return true;
            var current = element;
            while (current && current.nodeType === 1) {
                if (current.hidden === true) return false;
                var style = parent.getComputedStyle(current);
                if (!style || style.display === "none" || style.visibility === "hidden" || parseFloat(style.opacity || "1") === 0) return false;
                current = current.parentElement;
            }
            var rect = element.getBoundingClientRect();
            return rect.width > 0 && rect.height > 0;
        } catch (ignore) {
            return !document.hidden;
        }
    }

    function stopLiveTimers() {
        if (state.heartbeatTimer != null) { window.clearInterval(state.heartbeatTimer); state.heartbeatTimer = null; }
        if (state.liveMaxTimer != null) { window.clearTimeout(state.liveMaxTimer); state.liveMaxTimer = null; }
    }

    function sendHeartbeat() {
        if (!state.liveRequested || !state.subscriptionActive || !state.subscriptionId) return false;
        if (!isPluginVisible()) {
            stopLiveEvents("Live monitoring stopped because the Printers tab is no longer visible.", false);
            return false;
        }
        parent.meshserver.send({
            action: "plugin",
            plugin: "printercontrol",
            pluginaction: "heartbeatJobs",
            nodeid: state.nodeid,
            params: { subscriptionId: state.subscriptionId }
        });
        return true;
    }

    function startLiveTimers() {
        stopLiveTimers();
        sendHeartbeat();
        state.heartbeatTimer = window.setInterval(sendHeartbeat, 15000);
        state.liveMaxTimer = window.setTimeout(function () {
            if (state.liveRequested) stopLiveEvents("Live monitoring stopped after the 10-minute safety limit. Press Start live events to enable it again.", false);
        }, 600000);
    }

    function clearLiveState() {
        stopLiveTimers();
        state.liveRequested = false;
        state.subscriptionActive = false;
        state.watcherReady = false;
        state.subscriptionPrinter = null;
        state.liveSwitchInFlight = false;
        state.pendingTestPrinter = null;
        setLiveBadge("Live events off", "unknown");
        stopActivityFeed();
        updateButtons();
    }

    function startLiveEvents() {
        if (!state.selectedPrinter || !state.online || !hasPermission("can_view") || state.liveRequested) return false;
        state.unloading = false;
        state.liveRequested = true;
        state.subscriptionPrinter = state.selectedPrinter;
        state.subscriptionActive = false;
        state.watcherReady = false;
        setLiveBadge("Starting live events...", "unknown");
        startActivityFeed();
        updateButtons();
        if (!sendSubscription(true, state.selectedPrinter)) {
            clearLiveState();
            return false;
        }
        return true;
    }

    function stopLiveEvents(reason, silent) {
        var printerName = state.subscriptionPrinter || state.selectedPrinter;
        var shouldUnsubscribe = state.subscriptionActive || state.liveRequested || !!state.subscriptionPrinter;
        state.liveRequested = false;
        stopLiveTimers();
        if (shouldUnsubscribe && state.subscriptionId) sendSubscription(false, printerName);
        state.subscriptionActive = false;
        state.watcherReady = false;
        state.subscriptionPrinter = null;
        state.liveSwitchInFlight = false;
        state.pendingTestPrinter = null;
        setLiveBadge("Live events off", "unknown");
        stopActivityFeed();
        updateButtons();
        if (reason && silent !== true && !state.unloading) setMessage(reason);
        return shouldUnsubscribe;
    }

    function toggleLiveEvents() {
        if (state.liveRequested || state.subscriptionActive) return stopLiveEvents("Live monitoring stopped.", false);
        return startLiveEvents();
    }

    function unsubscribeJobs() {
        state.unloading = true;
        stopTestPageJobDiscovery();
        return stopLiveEvents(null, true);
    }

    function clearPendingJobEvents() {
        state.pendingJobEvent = null;
        if (state.eventRefreshTimer != null) {
            window.clearTimeout(state.eventRefreshTimer);
            state.eventRefreshTimer = null;
        }
    }

    function renderActivity() {
        var panel = document.getElementById("activityPanel");
        var body = document.getElementById("activityRows");
        panel.hidden = false;
        body.textContent = "";
        var active = [];
        for (var key in state.liveJobsByPrinter) {
            if (!Object.prototype.hasOwnProperty.call(state.liveJobsByPrinter, key)) continue;
            var bucket = state.liveJobsByPrinter[key];
            if (!bucket || !Array.isArray(bucket.jobs)) continue;
            for (var i = 0; i < bucket.jobs.length; i++) {
                active.push({ printerName: bucket.printerName, job: bucket.jobs[i] });
            }
        }
        active.sort(function (a, b) {
            var printerCompare = String(a.printerName).localeCompare(String(b.printerName));
            if (printerCompare !== 0) return printerCompare;
            return Number(getJobValue(a.job, ["id", "Id", "ID"], 0)) -
                Number(getJobValue(b.job, ["id", "Id", "ID"], 0));
        });
        document.getElementById("activityCount").textContent =
            active.length ? active.length + " active job(s)" : "0 active jobs";
        if (!active.length) {
            var empty = document.createElement("tr");
            var emptyCell = textCell(empty, state.liveRequested ?
                "Monitoring all printers — no active print jobs." :
                "Live monitoring is stopped.");
            emptyCell.colSpan = 7;
            emptyCell.className = "empty";
            body.appendChild(empty);
            return;
        }
        active.forEach(function (entry) {
            var job = entry.job;
            var pagesPrinted = Number(getJobValue(job, ["pagesPrinted", "PagesPrinted"], 0));
            var totalPages = Number(getJobValue(job, ["totalPages", "TotalPages"], 0));
            var rawStatus = getJobValue(job, ["jobStatus", "JobStatus", "status", "Status"], "");
            var row = document.createElement("tr");
            textCell(row, entry.printerName);
            textCell(row, getJobValue(job, ["id", "Id", "ID", "jobId", "JobId"], ""));
            textCell(row, getJobValue(job, ["documentName", "DocumentName", "document", "Document"], ""));
            textCell(row, getJobValue(job, ["userName", "UserName", "user", "User"], ""));
            textCell(row, formatJobStatus(job, rawStatus, pagesPrinted, totalPages));
            textCell(row, formatJobProgress(job, pagesPrinted, totalPages));
            textCell(row, getJobValue(job, ["size", "Size", "jobSize", "JobSize"], ""));
            body.appendChild(row);
        });
    }

    function startActivityFeed() {
        state.liveJobsByPrinter = {};
        document.getElementById("activityPanel").hidden = false;
        var badge = document.getElementById("activityBadge");
        badge.textContent = "Live";
        badge.className = "badge ok";
        renderActivity();
    }

    function stopActivityFeed() {
        state.liveJobsByPrinter = {};
        var badge = document.getElementById("activityBadge");
        badge.textContent = "Stopped";
        badge.className = "badge unknown";
        document.getElementById("activityPanel").hidden = true;
    }

    function recordActivity(event) {
        var jobs = Array.isArray(event.jobs) ? event.jobs : [];
        var active = [];
        for (var i = 0; i < jobs.length; i++) {
            if (!jobs[i] || jobs[i].recentCompleted === true) continue;
            active.push(jobs[i]);
        }
        var printerName = String(event.printerName || "");
        var key = printerName.toLowerCase();
        if (active.length) {
            state.liveJobsByPrinter[key] = { printerName: printerName, jobs: active };
        } else {
            delete state.liveJobsByPrinter[key];
        }
        renderActivity();
    }

    function switchLiveEventsForTest(printerName) {
        state.selectedPrinter = printerName;
        state.subscriptionPrinter = printerName;
        state.subscriptionActive = false;
        state.liveSwitchInFlight = true;
        state.pendingTestPrinter = printerName;
        stopLiveTimers();
        showPendingTestPageJob(printerName, "Preparing live monitoring...");
        setLiveBadge("Switching live events...", "unknown");
        setMessage("Switching live events to " + printerName + " before printing the test page...");
        updateButtons();
        if (sendSubscription(true, printerName)) return true;
        clearLiveState();
        setMessage("Unable to switch live events to the selected printer.", "error");
        return false;
    }

    function scheduleEventRender(event) {
        state.pendingJobEvent = event;
        if (state.eventRefreshTimer != null) return;
        state.eventRefreshTimer = window.setTimeout(function () {
            state.eventRefreshTimer = null;
            var latest = state.pendingJobEvent;
            state.pendingJobEvent = null;
            if (!latest || !state.selectedPrinter) return;
            var jobs = Array.isArray(latest.jobs) ? latest.jobs : [];
            var activeJobs = [];
            for (var i = 0; i < jobs.length; i++) {
                if (!jobs[i] || jobs[i].recentCompleted === true) continue;
                activeJobs.push(jobs[i]);
            }
            renderJobs({ printerName: latest.printerName, jobs: activeJobs });
            var eventName = String(latest.eventType || "");
            if (eventName.indexOf("Creation") >= 0) {
                setTransientMessage("A print job was detected and displayed automatically.", "success");
            } else if (eventName.indexOf("Deletion") >= 0) {
                setTransientMessage("Windows handed the job to the printer. Physical printing may still be in progress.", "success");
            }
        }, 100);
    }

    function setMessage(text, kind) {
        var box = document.getElementById("message");
        box.textContent = text || "";
        box.className = "message" + (kind ? " " + kind : "");
    }

    function setTransientMessage(text, kind) {
        setMessage(text, kind);
        window.setTimeout(function () {
            var box = document.getElementById("message");
            if (box.textContent === text) setMessage("");
        }, 5000);
    }

    function formatRemainingTime(milliseconds) {
        var totalSeconds = Math.max(0, Math.ceil(Number(milliseconds || 0) / 1000));
        var minutes = Math.floor(totalSeconds / 60);
        var seconds = totalSeconds % 60;
        return (minutes < 10 ? "0" : "") + minutes + ":" + (seconds < 10 ? "0" : "") + seconds;
    }

    function operationTimeoutMs(operation) {
        var value = OPERATION_TIMEOUTS_MS[operation];
        return typeof value === "number" && isFinite(value) && value > 0 ? value : DEFAULT_OPERATION_TIMEOUT_MS;
    }

    function stopOperationTimer() {
        if (state.operationTimer != null) {
            window.clearInterval(state.operationTimer);
            state.operationTimer = null;
        }
        state.operationDeadline = 0;
        state.operationTimerPrefix = "";
        state.operationTimerJobsPlaceholder = false;
    }

    function startOperationTimer(prefix, timeoutInMs, updateJobsPlaceholder) {
        stopOperationTimer();
        var duration = Number(timeoutInMs);
        if (!isFinite(duration) || duration < 0) duration = DEFAULT_OPERATION_TIMEOUT_MS;
        state.operationDeadline = Date.now() + duration;
        state.operationTimerPrefix = String(prefix || "Printer operation running");
        state.operationTimerJobsPlaceholder = updateJobsPlaceholder === true;

        function renderOperationTimer() {
            var remaining = Math.max(0, state.operationDeadline - Date.now());
            var text = state.operationTimerPrefix + " — timeout in " + formatRemainingTime(remaining);
            setMessage(text);
            if (state.operationTimerJobsPlaceholder) showJobsPlaceholder(text, false);
            if (remaining <= 0 && state.operationTimer != null) {
                window.clearInterval(state.operationTimer);
                state.operationTimer = null;
            }
        }

        renderOperationTimer();
        if (state.operationDeadline > Date.now()) {
            state.operationTimer = window.setInterval(renderOperationTimer, 1000);
        }
    }

    function updateButtons() {
        var operationBusy = state.activeClientRequestId != null || state.liveSwitchInFlight;
        var buttons = document.querySelectorAll("[data-permission]");
        for (var i = 0; i < buttons.length; i++) {
            buttons[i].disabled = operationBusy || !state.online || !hasPermission(buttons[i].getAttribute("data-permission"));
        }
        document.getElementById("refreshBtn").disabled = operationBusy || !hasPermission("can_view");
        document.getElementById("jobsRefresh").disabled = operationBusy || !state.online || !hasPermission("can_view") || !state.selectedPrinter;
        var liveButton = document.getElementById("jobsLiveToggle");
        if (liveButton) {
            var liveActive = state.liveRequested || state.subscriptionActive;
            liveButton.disabled = operationBusy || !state.online || !hasPermission("can_view") || !state.selectedPrinter;
            liveButton.textContent = liveActive ? "Stop live events" : "Start live events";
            liveButton.className = "small" + (liveActive ? " danger" : "");
        }
    }

    function setSpoolerBadge(status) {
        var badge = document.getElementById("spoolerBadge");
        var value = String(status || "Unknown").trim();
        var normalized = value.toLowerCase();

        badge.textContent = value;
        if (normalized === "running") {
            badge.className = "badge ok";
        } else if (normalized === "stopped") {
            badge.className = "badge bad";
        } else {
            badge.className = "badge unknown";
        }
    }

    function send(operation, params, options) {
        if (!state.nodeid) { setMessage("Missing node identifier.", "error"); return false; }
        options = options || {};
        if (state.activeClientRequestId != null) {
            if (!options.silent) setMessage("Another printer operation is already running.");
            return false;
        }
        if (operation === "inventory" && state.inventoryRequestInFlight) {
            if (!options.silent) setMessage("Inventory refresh is already running.");
            return false;
        }
        if (operation === "inventory") {
            var shared = sharedInventory();
            if (sharedInventoryIsPending(shared)) {
                state.inventoryRequestInFlight = true;
                if (!options.silent) setMessage("Waiting for the printer inventory already running on this device...");
                return false;
            }
        }
        if (operation === "jobs" && state.jobsRequestInFlight) return false;

        var clientRequestId = createSubscriptionId();
        state.activeClientRequestId = clientRequestId;
        state.activeOperation = operation;

        // Inventory can take time. Never start a second request while the
        // previous manual or post-operation refresh is still pending.
        if (operation === "inventory") {
            state.inventoryRequestInFlight = true;
            shared.pending = true;
            shared.pendingAt = Date.now();
            state.preserveSpoolerBadgeOnInventoryFailure = options.preserveSpoolerBadge === true;
            if (!state.preserveSpoolerBadgeOnInventoryFailure) setSpoolerBadge("Checking...");
        } else if (operation === "jobs") {
            state.jobsRequestInFlight = true;
            state.jobsRequestSilent = options.silent === true;
            if (!state.jobsRequestSilent) showJobsPlaceholder("Loading print jobs...", false);
        } else if (operation === "spoolerStart") {
            setSpoolerBadge("Starting...");
        } else if (operation === "spoolerStop") {
            setSpoolerBadge("Stopping...");
        } else if (operation === "spoolerRestart") {
            setSpoolerBadge("Restarting...");
        }

        startOperationTimer("Running " + operation, operationTimeoutMs(operation), operation === "jobs" && !state.jobsRequestSilent);
        parent.meshserver.send({
            action: "plugin",
            plugin: "printercontrol",
            pluginaction: operation,
            nodeid: state.nodeid,
            clientRequestId: clientRequestId,
            params: params || {}
        });
        updateButtons();
        return true;
    }

    function textCell(row, value) {
        var cell = document.createElement("td");
        cell.textContent = value == null ? "" : String(value);
        row.appendChild(cell);
        return cell;
    }

    function button(label, permission, callback, danger) {
        var value = document.createElement("button");
        value.type = "button";
        value.className = "small" + (danger ? " danger" : "");
        value.textContent = label;
        value.setAttribute("data-permission", permission);
        value.disabled = !state.online || !hasPermission(permission);
        value.onclick = callback;
        return value;
    }

    function renderInventory(data) {
        state.inventory = data || {};
        var spooler = data && data.spooler ? data.spooler.status : "Unknown";
        setSpoolerBadge(spooler);
        state.preserveSpoolerBadgeOnInventoryFailure = false;

        var drivers = data && Array.isArray(data.drivers) ? data.drivers : [];
        var driverList = document.getElementById("driverList");
        driverList.textContent = "";
        drivers.forEach(function (driver) {
            var option = document.createElement("option");
            option.value = driver.name || "";
            driverList.appendChild(option);
        });

        var printers = data && Array.isArray(data.printers) ? data.printers : [];
        document.getElementById("printerCount").textContent = printers.length + " printer(s)";
        var body = document.getElementById("printerRows");
        body.textContent = "";
        if (!printers.length) {
            var empty = document.createElement("tr");
            var emptyCell = textCell(empty, "No printers found.");
            emptyCell.colSpan = 7;
            emptyCell.className = "empty";
            body.appendChild(empty);
            return;
        }

        printers.forEach(function (printer) {
            var row = document.createElement("tr");
            textCell(row, (printer.default ? "★ " : "") + (printer.name || ""));
            textCell(row, printer.status || "Unknown");
            textCell(row, printer.driverName || "");
            textCell(row, printer.portName || "");
            textCell(row, printer.jobCount || 0);
            textCell(row, printer.shared ? (printer.shareName || "Yes") : "No");
            var actionCell = document.createElement("td");
            actionCell.className = "actions";
            actionCell.appendChild(button("Jobs", "can_view", function () { loadJobs(printer.name); }));
            actionCell.appendChild(button("Test", "manage_printers", function () { testPage(printer.name); }));
            actionCell.appendChild(button("Delete", "manage_printers", function () { deletePrinter(printer); }, true));
            row.appendChild(actionCell);
            body.appendChild(row);
        });
    }

    function showJobsPlaceholder(text, isError) {
        var body = document.getElementById("jobRows");
        body.textContent = "";
        var row = document.createElement("tr");
        var cell = textCell(row, text);
        cell.colSpan = 7;
        cell.className = "empty" + (isError ? " error-text" : "");
        body.appendChild(row);
    }

    function showPendingTestPageJob(printerName, status) {
        state.selectedPrinter = printerName;
        document.getElementById("jobsTitle").textContent = "Print jobs — " + printerName;
        var body = document.getElementById("jobRows");
        body.textContent = "";
        var row = document.createElement("tr");
        textCell(row, "—");
        textCell(row, "Windows Test Page");
        textCell(row, "");
        textCell(row, status || "Submitting...");
        textCell(row, "—");
        textCell(row, "—");
        var action = textCell(row, "Waiting");
        action.className = "muted";
        body.appendChild(row);
    }

    function stopTestPageJobDiscovery() {
        if (state.testPageJobRetryTimer != null) {
            window.clearTimeout(state.testPageJobRetryTimer);
            state.testPageJobRetryTimer = null;
        }
        state.testPageJobPrinter = null;
        state.testPageJobRetryIndex = 0;
    }

    function scheduleTestPageJobRetry() {
        if (!state.testPageJobPrinter ||
                state.testPageJobRetryIndex >= TEST_PAGE_JOB_RETRY_DELAYS_MS.length) {
            var completedPrinter = state.testPageJobPrinter;
            stopTestPageJobDiscovery();
            if (completedPrinter) {
                state.testPageEventPrinter = null;
                showJobsPlaceholder("No active print job was detected. It may have completed already or the printer may require interactive input.", false);
                setMessage("The test-page command completed, but no active queue item was detected for " + completedPrinter + ".");
            }
            return false;
        }
        var delay = TEST_PAGE_JOB_RETRY_DELAYS_MS[state.testPageJobRetryIndex++];
        var printerName = state.testPageJobPrinter;
        showPendingTestPageJob(printerName, "Waiting for queue...");
        state.testPageJobRetryTimer = window.setTimeout(function () {
            state.testPageJobRetryTimer = null;
            if (!state.testPageJobPrinter ||
                    String(state.testPageJobPrinter).toLowerCase() !== String(printerName).toLowerCase() ||
                    String(state.selectedPrinter || "").toLowerCase() !== String(printerName).toLowerCase()) {
                stopTestPageJobDiscovery();
                return;
            }
            if (!loadJobs(printerName, true)) scheduleTestPageJobRetry();
        }, delay);
        return true;
    }

    function beginTestPageJobDiscovery(printerName) {
        stopTestPageJobDiscovery();
        state.testPageJobPrinter = printerName;
        state.testPageJobRetryIndex = 0;
        showPendingTestPageJob(printerName, "Checking print queue...");
        if (!loadJobs(printerName, true)) scheduleTestPageJobRetry();
    }

    function getJobValue(job, names, fallback) {
        if (!job || typeof job !== "object") return fallback;
        for (var i = 0; i < names.length; i++) {
            if (job[names[i]] !== undefined && job[names[i]] !== null) return job[names[i]];
        }
        return fallback;
    }

    function normalizeJobs(data) {
        var raw = data ? data.jobs : null;
        if (Array.isArray(raw)) return raw;
        // PowerShell/ConvertTo-Json can return a single queue item as an object
        // instead of an array. Treat that object as a one-item queue.
        if (raw && typeof raw === "object") return [raw];
        return [];
    }

    function formatJobStatus(job, rawStatus, pagesPrinted, totalPages) {
        if (job && job.recentCompleted === true) return "Sent to printer";
        var status = String(rawStatus || "").trim();
        if (pagesPrinted > 0 && totalPages > pagesPrinted &&
                !/printing|spooling|paused|error|offline|blocked/i.test(status)) {
            return "Printing";
        }
        return status || "Queued";
    }

    function formatJobProgress(job, pagesPrinted, totalPages) {
        if (job && job.recentCompleted === true) return "Spooler finished";
        var printed = Number(pagesPrinted);
        var total = Number(totalPages);
        if (!isFinite(printed) || printed < 0) printed = 0;
        if (!isFinite(total) || total <= 0) {
            return printed > 0 ? printed + " printed / remaining unknown" : "Not reported";
        }
        printed = Math.min(Math.floor(printed), Math.floor(total));
        total = Math.floor(total);
        return printed + " printed / " + (total - printed) + " remaining";
    }

    function renderJobs(data) {
        if (data && data.printerName) state.selectedPrinter = data.printerName;
        document.getElementById("jobsTitle").textContent = "Print jobs" + (state.selectedPrinter ? " — " + state.selectedPrinter : "");
        updateButtons();
        var jobs = normalizeJobs(data);
        var body = document.getElementById("jobRows");
        body.textContent = "";
        if (!jobs.length) {
            var empty = document.createElement("tr");
            var emptyCell = textCell(empty, "The queue is empty.");
            emptyCell.colSpan = 7;
            emptyCell.className = "empty";
            body.appendChild(empty);
            return;
        }
        jobs.forEach(function (job) {
            var row = document.createElement("tr");
            var jobId = getJobValue(job, ["id", "Id", "ID", "jobId", "JobId"], "");
            var documentName = getJobValue(job, ["documentName", "DocumentName", "document", "Document"], "");
            var userName = getJobValue(job, ["userName", "UserName", "user", "User"], "");
            var jobStatus = getJobValue(job, ["jobStatus", "JobStatus", "status", "Status"], "");
            var pagesPrinted = getJobValue(job, ["pagesPrinted", "PagesPrinted"], 0);
            var totalPages = getJobValue(job, ["totalPages", "TotalPages"], 0);
            var size = getJobValue(job, ["size", "Size", "jobSize", "JobSize"], "");
            jobStatus = formatJobStatus(job, jobStatus, Number(pagesPrinted), Number(totalPages));
            var progress = formatJobProgress(job, pagesPrinted, totalPages);

            textCell(row, jobId);
            textCell(row, documentName);
            textCell(row, userName);
            textCell(row, jobStatus);
            textCell(row, progress);
            textCell(row, size);
            var actions = document.createElement("td");
            actions.className = "actions";
            if (job && job.recentCompleted === true) {
                actions.textContent = "Sent recently";
                actions.className += " muted";
            } else {
                actions.appendChild(button("Pause", "manage_jobs", function () { jobAction("pauseJob", jobId); }));
                actions.appendChild(button("Resume", "manage_jobs", function () { jobAction("resumeJob", jobId); }));
                actions.appendChild(button("Cancel", "manage_jobs", function () { jobAction("cancelJob", jobId); }, true));
            }
            row.appendChild(actions);
            body.appendChild(row);
        });
    }

    function loadJobs(printerName, silent) {
        if (state.activeClientRequestId != null) {
            if (silent !== true) setMessage("Wait for the current printer operation to finish.");
            return false;
        }
        var changedPrinter = state.selectedPrinter !== printerName;
        if (changedPrinter && state.testPageJobPrinter) stopTestPageJobDiscovery();
        if (changedPrinter && (state.liveRequested || state.subscriptionActive)) {
            stopLiveEvents("Live monitoring stopped because a different printer was selected.", true);
        }
        state.selectedPrinter = printerName;
        document.getElementById("jobsTitle").textContent = "Print jobs — " + printerName;
        updateButtons();
        return send("jobs", { printerName: printerName }, { silent: silent === true });
    }

    function testPage(printerName) {
        if (state.activeClientRequestId != null || state.liveSwitchInFlight) {
            setMessage("Wait for the current printer operation to finish.");
            return false;
        }
        stopTestPageJobDiscovery();
        state.testPageEventPrinter = null;
        clearPendingJobEvents();
        state.selectedPrinter = printerName;
        showPendingTestPageJob(printerName, "Submitting...");
        updateButtons();
        var liveActive = state.liveRequested || state.subscriptionActive;
        if (liveActive) {
            var monitoredPrinter = state.subscriptionPrinter || state.selectedPrinter || "";
            if (String(monitoredPrinter).toLowerCase() !== String(printerName).toLowerCase()) {
                return switchLiveEventsForTest(printerName);
            }
        }
        return send("testPage", { printerName: printerName });
    }

    function jobAction(operation, jobId) {
        if (!state.selectedPrinter) return;
        if (operation === "cancelJob" && !confirm("Cancel print job " + jobId + "?")) return;
        send(operation, { printerName: state.selectedPrinter, jobId: jobId });
    }

    function deletePrinter(printer) {
        if (!confirm("Delete printer '" + printer.name + "'? Print jobs for this printer will also be removed.")) return;
        var deletePort = confirm("Also remove port '" + printer.portName + "' if no other printer uses it?");
        var deleteDriver = false;
        if (hasPermission("manage_drivers")) {
            deleteDriver = confirm("Also remove driver '" + printer.driverName + "' if no other printer uses it?");
        }
        send("deletePrinter", { printerName: printer.name, deletePort: deletePort, deleteDriver: deleteDriver });
    }

    function clearQueue() {
        if (!confirm("Clear ALL queued print jobs on this computer? The Print Spooler will be restarted.")) return;
        send("clearQueue", {});
    }

    function addTcpPrinter() {
        var name = document.getElementById("addName").value.trim();
        var address = document.getElementById("addAddress").value.trim();
        var driverName = document.getElementById("addDriver").value.trim();
        var portName = document.getElementById("addPort").value.trim();
        if (!name || !address || !driverName) { setMessage("Printer name, address and installed driver are required.", "error"); return; }
        var params = { name: name, address: address, driverName: driverName };
        if (portName) params.portName = portName;
        send("addTcpPrinter", params);
    }

    function handleMessage(message) {
        if (!message || message.nodeid && message.nodeid !== state.nodeid) return;

        if (message.type === "permissions") {
            var firstPermissionsResult = !state.permissionsLoaded;
            var manualRefreshRequested = state.manualRefreshPending;
            state.permissionsRequestInFlight = false;
            if (state.permissionsTimer != null) {
                window.clearTimeout(state.permissionsTimer);
                state.permissionsTimer = null;
            }
            state.manualRefreshPending = false;
            state.online = message.online === true;
            state.permissions = Array.isArray(message.permissions) ? message.permissions : [];
            state.permissionsLoaded = true;

            var online = document.getElementById("onlineBadge");
            online.textContent = state.online ? "Agent online" : "Agent offline";
            online.className = "badge " + (state.online ? "ok" : "bad");
            updateButtons();

            if (!hasPermission("can_view")) {
                setMessage("Access denied. Grant the 'View printers' plugin permission for this user, group or device.", "error");
            } else if (!state.online) {
                state.inventoryRequestInFlight = false;
                state.jobsRequestInFlight = false;
                state.jobsRequestSilent = false;
                state.activeClientRequestId = null;
                state.activeOperation = null;
                stopOperationTimer();
                clearLiveState();
                setSpoolerBadge("Unknown");
                setMessage("MeshAgent is offline.", "error");
            } else if (firstPermissionsResult || manualRefreshRequested) {
                // Load inventory once when the page opens, and thereafter only
                // when the user presses Refresh or an operation needs one update.
                var shared = sharedInventory();
                var waitingForSharedInventory = sharedInventoryIsPending(shared);
                if (firstPermissionsResult && shared.data) {
                    renderInventory(shared.data);
                    if (waitingForSharedInventory) {
                        setMessage("Showing the last inventory while an update is already running...", "success");
                    } else {
                        // MeshCentral rebuilds plugin pages during periodic device
                        // refreshes. Cached inventory restoration is expected and
                        // should not look like a new user-visible operation.
                        setMessage("");
                    }
                }
                if (waitingForSharedInventory) {
                    state.inventoryRequestInFlight = true;
                    if (!shared.data) setMessage("Waiting for the printer inventory already running on this device...");
                } else if (manualRefreshRequested || !shared.data) {
                    refresh(false, false);
                }
            }
            return;
        }

        if (message.type === "subscription") {
            if (message.subscriptionId !== state.subscriptionId) return;
            state.subscriptionActive = message.success === true && message.active === true && state.liveRequested;
            if (state.subscriptionActive) {
                state.subscriptionPrinter = message.printerName || state.selectedPrinter;
                setLiveBadge(state.watcherReady ? "Live events on" : "Starting live events...", state.watcherReady ? "ok" : "unknown");
                startLiveTimers();
            } else if (!state.liveRequested) {
                clearLiveState();
            }
            var pendingTestPrinter = state.pendingTestPrinter;
            if (state.subscriptionActive && pendingTestPrinter &&
                    String(state.subscriptionPrinter || "").toLowerCase() === String(pendingTestPrinter).toLowerCase()) {
                state.pendingTestPrinter = null;
                state.liveSwitchInFlight = false;
                showPendingTestPageJob(pendingTestPrinter, "Submitting...");
                updateButtons();
                send("testPage", { printerName: pendingTestPrinter });
                return;
            }
            updateButtons();
            return;
        }

        if (message.type === "watcherStatus") {
            if (message.success === true && state.liveRequested && state.subscriptionActive) {
                state.watcherReady = true;
                setLiveBadge("Live events on", "ok");
            } else if (message.success !== true) {
                stopLiveTimers();
                state.liveRequested = false;
                state.watcherReady = false;
                state.subscriptionActive = false;
                state.subscriptionPrinter = null;
                setLiveBadge("Live events unavailable", "bad");
                updateButtons();
                if (!state.unloading) setMessage(message.error || "Automatic print-job events are unavailable. Use Refresh jobs.", "error");
            }
            return;
        }

        if (message.type === "heartbeat") {
            if (message.subscriptionId !== state.subscriptionId) return;
            if (message.success !== true) {
                clearLiveState();
                if (!state.unloading) setMessage(message.error || "Live monitoring subscription expired.", "error");
            }
            return;
        }

        if (message.type === "subscriptionExpired") {
            if (message.subscriptionId !== state.subscriptionId) return;
            clearLiveState();
            if (!state.unloading) setMessage(message.reason || "Live monitoring expired. Press Start live events to enable it again.", "error");
            return;
        }

        if (message.type === "jobEvent") {
            if (message.subscriptionId !== state.subscriptionId || !state.selectedPrinter || !message.event) return;
            var eventPrinter = String(message.event.printerName || "");
            if (!eventPrinter) return;
            recordActivity(message.event);
            if (eventPrinter.toLowerCase() !== String(state.selectedPrinter).toLowerCase()) {
                return;
            }
            if (state.activeOperation === "testPage" ||
                    (state.testPageJobPrinter &&
                     String(state.testPageJobPrinter).toLowerCase() === String(state.selectedPrinter).toLowerCase())) {
                state.testPageEventPrinter = state.selectedPrinter;
            }
            stopTestPageJobDiscovery();
            scheduleEventRender(message.event);
            return;
        }

        if (message.type === "queued") {
            if (message.clientRequestId && message.clientRequestId !== state.activeClientRequestId) return;
            var waitingFor = message.activeOperation ? "Waiting for the current " + message.activeOperation + " operation to finish" : "Printer read queued";
            startOperationTimer(waitingFor, message.timeoutInMs, message.operation === "jobs");
            return;
        }

        if (message.type === "started") {
            if (message.clientRequestId && message.clientRequestId !== state.activeClientRequestId) return;
            startOperationTimer("Running " + String(message.operation || state.activeOperation || "printer operation"),
                message.timeoutInMs, message.operation === "jobs" && !state.jobsRequestSilent);
            return;
        }

        if (message.type !== "result") return;

        if (message.clientRequestId && state.activeClientRequestId && message.clientRequestId !== state.activeClientRequestId) return;
        var completesActiveOperation = state.activeClientRequestId != null &&
            ((message.clientRequestId && message.clientRequestId === state.activeClientRequestId) ||
             (!message.clientRequestId && message.operation === state.activeOperation));
        if (completesActiveOperation) {
            stopOperationTimer();
            state.activeClientRequestId = null;
            state.activeOperation = null;
            updateButtons();
        }

        if (!message.success) {
            var suppressErrorMessage = false;
            if (message.operation === "getPermissions") {
                state.permissionsRequestInFlight = false;
                state.manualRefreshPending = false;
                if (state.permissionsTimer != null) {
                    window.clearTimeout(state.permissionsTimer);
                    state.permissionsTimer = null;
                }
            } else if (message.operation === "inventory") {
                state.inventoryRequestInFlight = false;
                var failedSharedInventory = sharedInventory();
                failedSharedInventory.pending = false;
                failedSharedInventory.pendingAt = 0;
                if (!state.preserveSpoolerBadgeOnInventoryFailure) setSpoolerBadge("Unknown");
                state.preserveSpoolerBadgeOnInventoryFailure = false;
            } else if (message.operation === "jobs") {
                state.jobsRequestInFlight = false;
                suppressErrorMessage = state.jobsRequestSilent;
                state.jobsRequestSilent = false;
                var failedEventResult = state.testPageEventPrinter &&
                    String(state.testPageEventPrinter).toLowerCase() === String(state.selectedPrinter || "").toLowerCase();
                var failedDiscovery = state.testPageJobPrinter &&
                    String(state.testPageJobPrinter).toLowerCase() === String(state.selectedPrinter || "").toLowerCase();
                if (failedEventResult) {
                    stopTestPageJobDiscovery();
                    state.testPageEventPrinter = null;
                    suppressErrorMessage = true;
                } else if (failedDiscovery) {
                    scheduleTestPageJobRetry();
                    suppressErrorMessage = true;
                } else {
                    showJobsPlaceholder(message.error || "Unable to load print jobs.", true);
                }
            } else if (message.operation === "testPage") {
                stopTestPageJobDiscovery();
                state.testPageEventPrinter = null;
                showJobsPlaceholder("The test page could not be submitted: " +
                    (message.error || "Printer operation failed."), true);
            } else if (message.operation === "subscribeJobs" || message.operation === "heartbeatJobs") {
                clearLiveState();
                setLiveBadge("Live events unavailable", "bad");
            } else if (message.operation === "unsubscribeJobs") {
                clearLiveState();
            } else if (message.operation === "spoolerStart" || message.operation === "spoolerStop" || message.operation === "spoolerRestart") {
                setSpoolerBadge("Unknown");
            }
            if (!suppressErrorMessage) setMessage(message.error || "Printer operation failed.", "error");
            return;
        }

        if (message.operation === "inventory") {
            state.inventoryRequestInFlight = false;
            var completedSharedInventory = sharedInventory();
            completedSharedInventory.pending = false;
            completedSharedInventory.pendingAt = 0;
            completedSharedInventory.data = message.data;
            completedSharedInventory.updatedAt = Date.now();
            renderInventory(message.data);
            return;
        }

        if (message.operation === "jobs") {
            var silentJobsResult = state.jobsRequestSilent;
            state.jobsRequestInFlight = false;
            state.jobsRequestSilent = false;
            var jobs = normalizeJobs(message.data);
            var resultPrinter = message.data && message.data.printerName ?
                message.data.printerName : state.selectedPrinter;
            var eventAlreadyDisplayed = silentJobsResult && state.testPageEventPrinter &&
                String(state.testPageEventPrinter).toLowerCase() === String(resultPrinter || "").toLowerCase();
            var discoveryResult = state.testPageJobPrinter &&
                String(state.testPageJobPrinter).toLowerCase() === String(resultPrinter || "").toLowerCase();
            if (eventAlreadyDisplayed) {
                stopTestPageJobDiscovery();
                state.testPageEventPrinter = null;
            } else if (discoveryResult) {
                if (jobs.length) {
                    stopTestPageJobDiscovery();
                    state.testPageEventPrinter = null;
                    renderJobs(message.data);
                    setMessage("The test-page print job was detected.", "success");
                } else {
                    scheduleTestPageJobRetry();
                }
            } else {
                if (!silentJobsResult) setMessage("Print jobs loaded.", "success");
                renderJobs(message.data);
            }
            return;
        }

        if (message.operation === "testPage") {
            var testPrinter = message.data && message.data.printerName ?
                message.data.printerName : state.selectedPrinter;
            if (state.testPageEventPrinter &&
                    String(state.testPageEventPrinter).toLowerCase() === String(testPrinter || "").toLowerCase()) {
                state.testPageEventPrinter = null;
                setMessage("The test-page print job was detected.", "success");
                return;
            }
            setMessage("Test-page command accepted. Checking the print queue...", "success");
            beginTestPageJobDiscovery(testPrinter);
            return;
        }

        setMessage((message.operation || "Operation") + " completed.", "success");
        if (message.operation === "cancelJob" || message.operation === "pauseJob" || message.operation === "resumeJob") {
            reloadJobs(false);
        } else if (message.operation === "spoolerStop") {
            setSpoolerBadge("Stopped");
            refresh(true, true);
        } else if (message.operation === "spoolerStart") {
            setSpoolerBadge("Running");
            refresh(true, true);
        } else if (message.operation === "spoolerRestart") {
            setSpoolerBadge("Running");
            refresh(true, true);
        } else if (message.operation === "addTcpPrinter" || message.operation === "deletePrinter" ||
                   message.operation === "removePort" || message.operation === "removeDriver" ||
                   message.operation === "clearQueue") {
            refresh(false, true);
        }
    }

    function refresh(preserveSpoolerBadge, silent) {
        if (!state.online || !hasPermission("can_view")) return false;
        return send("inventory", {}, {
            preserveSpoolerBadge: preserveSpoolerBadge === true,
            silent: silent === true
        });
    }

    function reloadJobs(silent) {
        if (state.selectedPrinter) loadJobs(state.selectedPrinter, silent === true);
    }

    function requestPermissions() {
        if (!state.nodeid || state.permissionsRequestInFlight) return false;
        state.permissionsRequestInFlight = true;
        if (state.permissionsTimer != null) window.clearTimeout(state.permissionsTimer);
        state.permissionsTimer = window.setTimeout(function () {
            state.permissionsTimer = null;
            if (!state.permissionsRequestInFlight) return;
            state.permissionsRequestInFlight = false;
            state.manualRefreshPending = false;
            updateButtons();
            setMessage("Permission and agent-status request timed out.", "error");
        }, 30000);
        parent.meshserver.send({ action:"plugin", plugin:"printercontrol", pluginaction:"getPermissions", nodeid:state.nodeid });
        return true;
    }

    function manualRefresh() {
        if (!state.nodeid || !hasPermission("can_view")) return false;
        if (state.permissionsRequestInFlight || state.inventoryRequestInFlight || state.activeClientRequestId != null) {
            setMessage("A refresh is already running.");
            return false;
        }
        state.manualRefreshPending = true;
        setMessage("Checking agent and printer inventory...");
        if (!requestPermissions()) {
            state.manualRefreshPending = false;
            return false;
        }
        return true;
    }

    function initialize() {
        if (!state.subscriptionId) state.subscriptionId = createSubscriptionId();
        state.unloading = false;
        return requestPermissions();
    }

    return {
        initialize: initialize,
        requestPermissions: requestPermissions,
        handleMessage: handleMessage,
        refresh: refresh,
        reloadJobs: reloadJobs,
        testPage: testPage,
        run: send,
        clearQueue: clearQueue,
        addTcpPrinter: addTcpPrinter,
        manualRefresh: manualRefresh,
        toggleLiveEvents: toggleLiveEvents,
        startLiveEvents: startLiveEvents,
        stopLiveEvents: stopLiveEvents,
        checkLiveVisibility: function () { if (state.liveRequested && !isPluginVisible()) stopLiveEvents("Live monitoring stopped because the Printers tab is no longer visible.", false); },
        unsubscribeJobs: unsubscribeJobs
    };
})();

function printerControlOnLoad() {
    if (!parent.pluginHandler.printercontrol) parent.pluginHandler.printercontrol = {};
    parent.pluginHandler.printercontrol.handlePrinterMessage = function (x, message) {
        PrinterControl.handleMessage(message);
    };
    PrinterControl.initialize();
    window.addEventListener("pagehide", PrinterControl.unsubscribeJobs);
    window.addEventListener("beforeunload", PrinterControl.unsubscribeJobs);
    document.addEventListener("visibilitychange", PrinterControl.checkLiveVisibility);
}
</script>
</body>
</html>
